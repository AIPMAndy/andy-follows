# Environment Configuration for Andy Follows
# Copy this to ~/.andy-follows/.env and fill in your values

# ============================================
# Telegram Configuration (Optional)
# ============================================
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Get chat ID by messaging your bot and visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# ============================================
# Lark/Feishu Configuration (Optional)
# ============================================
# Create a custom bot in Lark/Feishu and get webhook URL
LARK_WEBHOOK_URL=

# ============================================
# Schedule Configuration
# ============================================
# Frequency: daily | weekly
DIGEST_FREQUENCY=daily

# Time in HH:MM format (24-hour)
DIGEST_TIME=08:00

# Timezone (e.g., Asia/Shanghai, America/New_York, Europe/London)
DIGEST_TIMEZONE=Asia/Shanghai

# ============================================
# Content Preferences
# ============================================
# Language: english | chinese | bilingual
DIGEST_LANGUAGE=bilingual

# AI Relevance Threshold: high | medium | low
AI_RELEVANCE_THRESHOLD=high

# Summary Length: short | medium | long
SUMMARY_LENGTH=medium

# Max items per category
MAX_ITEMS_PER_CATEGORY=10
